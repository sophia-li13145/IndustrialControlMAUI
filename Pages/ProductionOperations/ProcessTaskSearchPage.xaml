<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:IndustrialControlMAUI.Behaviors"
             x:Class="IndustrialControlMAUI.Pages.ProcessTaskSearchPage"
             Shell.NavBarIsVisible="True">

    <!-- 根布局：顶部（蓝条） / 条件区 / 列表 -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部蓝条 -->
        <Grid Grid.Row="0" BackgroundColor="#007BFF" HeightRequest="56" Padding="16,0">
            <Label Text="生产管理系统"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold" />
        </Grid>

        <!-- 条件区 -->
        <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="10">
            <!-- 第一行：工单号 + 查询 + 扫码图标按钮 -->
            <Grid ColumnDefinitions="*,40,Auto">
                <Entry x:Name="OrderEntry"
                       Placeholder="请输入扫描工单号"
                       Text="{Binding Keyword}"
                       HeightRequest="40" />
                <ImageButton  Grid.Column="1"
                Source="scan_button.png"      
                WidthRequest="36"
                 HeightRequest="36"
                 BackgroundColor="Transparent"
                 Padding="0"
                 Aspect="AspectFit"
                 Clicked="OnScanClicked"  /> 
                <Button Grid.Column="2"
                        Text="查询"
                        HeightRequest="40"
                        Command="{Binding SearchCommand}" />

            </Grid>

            <!-- 第二行：开始时间 + 结束时间 + 状态，三项等宽铺满 -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8"
                  VerticalOptions="Center">

                <!-- 开始日期 -->
                <DatePicker Grid.Column="0"
                Date="{Binding StartDate}"
                HeightRequest="40"
                BackgroundColor="Transparent"
                TextColor="#333333" />

                <!-- 结束日期 -->
                <DatePicker Grid.Column="1"
                Date="{Binding EndDate}"
                HeightRequest="40"
                BackgroundColor="Transparent"
                TextColor="#333333" />

                <!-- 状态 -->
                <Grid Grid.Column="2"
                      HeightRequest="40"
                      RowDefinitions="38,2"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill">

                    <Grid Grid.Row="0"
          BackgroundColor="White"
          Padding="0"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">
                        <Label Text="{Binding SelectedStatusSummary}"
               FontSize="13"
               TextColor="#333333"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatusFilterClicked" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView Grid.Row="1"
             HeightRequest="2"
                             Margin="2,2,2,5"
             BackgroundColor="#BDBDBD"
             HorizontalOptions="Fill"
             VerticalOptions="End" />
                </Grid>

            </Grid>

            <!-- 第三行：工序 + 工位，两项等宽铺满 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Grid Grid.Column="0" HeightRequest="40" BackgroundColor="White"
                      HorizontalOptions="Fill">
                    <Label Text="{Binding SelectedProcessOption.Text}"
                           TextColor="#333333"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation" />
                    <BoxView HeightRequest="2"
                             Margin="2,0"
                             BackgroundColor="#BDBDBD"
                             VerticalOptions="End" />
                    <!-- 保留原生单选行为，仅由统一的标签和下划线负责展示。 -->
                    <Picker Title="工序"
                            ItemsSource="{Binding ProcessOptions}"
                            ItemDisplayBinding="{Binding Text}"
                            SelectedItem="{Binding SelectedProcessOption}"
                            Opacity="0" />
                </Grid>

                <Grid Grid.Column="1" HeightRequest="40" BackgroundColor="White"
                      HorizontalOptions="Fill">
                    <Label Text="{Binding SelectedWorkstationSummary}" TextColor="#333333"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                    <BoxView HeightRequest="2" Margin="2,0"
                             BackgroundColor="#BDBDBD" VerticalOptions="End" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWorkstationFilterClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <!-- 列表（自身可滚动，外面不要再套 ScrollView） -->
        <CollectionView Grid.Row="2"
                        x:Name="OrderList"
                        ItemsSource="{Binding Orders}"
                        SelectionMode="None"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Behaviors>
                <behaviors:ScrollToTopOnRefreshBehavior />
            </CollectionView.Behaviors>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6,0,0"
                           Padding="10"
                           HasShadow="False"
                           BorderColor="#E0E6EF">
                        <!-- 点整卡片就跳转 -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GoExecuteCommand}"
        CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <!-- 列表项内容 -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                <Label Text="工单编号：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding WorkOrderNo}" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                                <Label Text="工单名称：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding WorkOrderName}" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                <Label Text="工单状态：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding WorkOrderAuditStatusName}" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
                                <Label Text="工序：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding ProcessName}" />
                            </Grid>
                            <Grid Grid.Row="4" ColumnDefinitions="Auto,*">
                                <Label Text="工序任务状态：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding AuditStatusName}" />
                            </Grid>
                            
                            <Grid Grid.Row="5" ColumnDefinitions="Auto,*">
                                <Label Text="产品名称：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding MaterialName}" />
                            </Grid>
                            <Grid Grid.Row="6" ColumnDefinitions="Auto,*">
                                <Label Text="生产数量：" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding ScheQty, StringFormat='{0:G29}'}" />
                            </Grid>
                            <Grid Grid.Row="7" ColumnDefinitions="Auto,*">
                                <Label Text="创建时间：" FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding CreatedTime}" />
                            </Grid>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Grid Padding="8"
                      HorizontalOptions="Center"
                      IsVisible="{Binding IsLoadingMore}">
                    <ActivityIndicator IsRunning="True" />
                    <Label Text="加载中..."
                           Margin="8,0,0,0"
                           VerticalOptions="Center" />
                </Grid>
            </CollectionView.Footer>
        </CollectionView>

    </Grid>
</ContentPage>
