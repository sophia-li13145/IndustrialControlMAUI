<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IndustrialControlMAUI.Pages.ShiftHandoverPage"
             Title="交接班记录" BackgroundColor="#F6F7F9" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="44,*">
        <Grid BackgroundColor="#2F6DEA" Padding="12,0" ColumnDefinitions="32,*,Auto">
            <Border HeightRequest="28" WidthRequest="28" BackgroundColor="#F5D94E" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                <Grid>
                    <Label Text="←" TextColor="White" FontSize="18" Margin="0,-2,0,0"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="交接班记录" TextColor="White" FontSize="16"
                   FontAttributes="Bold" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding CurrentUserName, StringFormat='♙ {0}'}" TextColor="White"
                   FontSize="11" VerticalOptions="Center" HorizontalTextAlignment="End" />
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Spacing="0">
                    <Grid IsVisible="{Binding HasPendingHandover}" BackgroundColor="#FFFBE8" Padding="14,12"
                          ColumnDefinitions="24,*" RowDefinitions="Auto,Auto">
                        <Border HeightRequest="20" WidthRequest="20" BackgroundColor="#F5B800" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" VerticalOptions="Start" Margin="0,2,0,0">
                            <Label Text="!" TextColor="White" FontSize="12" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="待接班提醒" FontSize="14" FontAttributes="Bold" TextColor="#D28A00" />
                            <Label Text="{Binding PendingMessage}" FontSize="12" TextColor="#7D5900" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Row="1" Grid.Column="1" Text="去接班" BackgroundColor="#F0AD00" TextColor="White"
                                FontSize="12" FontAttributes="Bold" CornerRadius="15" HeightRequest="30" WidthRequest="72"
                                Padding="0" HorizontalOptions="Start" Margin="0,8,0,0" Command="{Binding OpenConfirmSheetCommand}" />
                    </Grid>

                    <VerticalStackLayout Padding="14,12,14,24" Spacing="10">
                        <Button Text="●  发起交接班" BackgroundColor="#2F6DEA" TextColor="White" FontSize="14"
                                FontAttributes="Bold" CornerRadius="9" HeightRequest="40" Padding="0"
                                Command="{Binding OpenStartSheetCommand}" />
                        <Label Text="近期记录" FontSize="12" TextColor="#7C8799" Margin="2,0,0,0" />
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                               TextColor="#E5484D" FontSize="12" HorizontalTextAlignment="Center" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Records}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="White" Stroke="#E9EDF3" StrokeShape="RoundRectangle 12"
                                            Padding="0" MinimumHeightRequest="120">
                                        <Grid ColumnDefinitions="3,*">
                                            <BoxView Color="{Binding AccentColor}" />
                                            <Grid Grid.Column="1" Padding="14,11" RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="*,Auto,*">
                                                <HorizontalStackLayout Grid.ColumnSpan="2" Spacing="6">
                                                    <Label Text="{Binding DateText}" FontSize="11" FontAttributes="Bold" TextColor="#344054" />
                                                    <Label Text="◷" FontSize="10" TextColor="#8791A3" VerticalOptions="Center" />
                                                    <Label Text="{Binding TimeText}" FontSize="10" TextColor="#8791A3" />
                                                </HorizontalStackLayout>
                                                <Border Grid.Column="2" BackgroundColor="{Binding StatusBackground}" Stroke="{Binding AccentColor}"
                                                        StrokeShape="RoundRectangle 3" Padding="4,1" HorizontalOptions="End">
                                                    <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold" TextColor="{Binding StatusTextColor}" />
                                                </Border>

                                                <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,10,0,8">
                                                    <Label Text="{Binding HandoverTeamName}" FontSize="14" FontAttributes="Bold" TextColor="#172033" />
                                                    <Label Text="{Binding HandoverUserName, StringFormat='♙ {0}'}" FontSize="10" TextColor="#667085" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Border HeightRequest="22" WidthRequest="22" Padding="0"
                                                            BackgroundColor="{Binding DirectionBackground}" Stroke="{Binding DirectionStroke}"
                                                            StrokeShape="RoundRectangle 11">
                                                        <Label Text="{Binding DirectionIcon}" FontSize="14" TextColor="{Binding DirectionTextColor}"
                                                               Margin="0,-1,0,0" HorizontalOptions="Center" VerticalOptions="Center"
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                    <Label Text="交接" FontSize="9" TextColor="#A7AFBD" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="4" Margin="0,10,0,8" HorizontalOptions="End">
                                                    <Label Text="{Binding ReceiverTeamName}" FontSize="14" FontAttributes="Bold" TextColor="#172033" HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding ReceiverUserName, StringFormat='♙ {0}'}" FontSize="10" TextColor="#667085" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>

                                                <BoxView Grid.Row="2" Grid.ColumnSpan="3" HeightRequest="1" Color="#EEF1F5" VerticalOptions="Start" />
                                                <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Memo, StringFormat='▧  {0}'}" FontSize="10"
                                                       TextColor="#667085" Margin="0,8,0,0" LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenDetailSheetCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding HasNoRecords}"
                                BackgroundColor="White" Stroke="#E9EDF3" StrokeShape="RoundRectangle 12" Padding="20">
                            <Label Text="暂无交接班记录" TextColor="#98A2B3" FontSize="13" HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsStartSheetVisible}" RowDefinitions="*,Auto" ZIndex="10">
            <BoxView Grid.RowSpan="2" Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseStartSheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,0,0"
                    Padding="17,8,17,14" ZIndex="11">
                <VerticalStackLayout Spacing="12">
                    <BoxView HeightRequest="4" WidthRequest="38" CornerRadius="2" Color="#D0D5DD" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="☁" FontSize="18" TextColor="#2F6DEA" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="发起交接班" FontSize="15" FontAttributes="Bold" TextColor="#172033"
                               VerticalOptions="Center" Margin="6,0,0,0" />
                    </Grid>

                    <Border BackgroundColor="#EFF6FF" Stroke="#C9DFFF" StrokeShape="RoundRectangle 9" Padding="12,10">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                            <Label Text="当前日期" FontSize="11" TextColor="#667085" />
                            <Label Grid.Column="1" Text="{Binding HandoverDate}" FontSize="12" FontAttributes="Bold" TextColor="#172033" />

                            <Label Grid.Row="1" Text="交班班组" FontSize="11" TextColor="#667085" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Text="{Binding HandoverTeamName}" FontSize="12" FontAttributes="Bold" TextColor="#1262E3"
                                       VerticalOptions="Center" />
                                <Border BackgroundColor="White" Stroke="#ABCFFF" StrokeShape="RoundRectangle 3" Padding="5,2">
                                    <Label Text="{Binding HandoverUserName}" FontSize="10" TextColor="#1262E3" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label Grid.Row="2" Text="接班班组  ⚙" FontSize="11" TextColor="#667085" VerticalOptions="Center" />
                            <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" Stroke="#ABCFFF"
                                    StrokeShape="RoundRectangle 7" Padding="8,0" MinimumWidthRequest="136" HeightRequest="34">
                                <Picker ItemsSource="{Binding ReceiverTeams}" SelectedItem="{Binding SelectedReceiverTeam}"
                                        ItemDisplayBinding="{Binding TeamName}" FontSize="12" TextColor="#1262E3"
                                        Title="请选择接班班组" />
                            </Border>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="现场情况/交班纪要 *" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
                        <Border BackgroundColor="#FAFBFC" Stroke="#D0D5DD" StrokeShape="RoundRectangle 8" Padding="8,5">
                            <Editor Text="{Binding HandoverMemo}" Placeholder="请记录设备运行情况、安全注意事项等..."
                                    PlaceholderColor="#98A2B3" FontSize="12" TextColor="#344054"
                                    AutoSize="TextChanges" MinimumHeightRequest="86" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid>
                        <Button Text="提交并流转记录" Command="{Binding SubmitHandoverCommand}" BackgroundColor="#2F6DEA"
                                TextColor="White" FontSize="14" FontAttributes="Bold" CornerRadius="8" HeightRequest="42" />
                        <ActivityIndicator IsRunning="{Binding IsSubmitting}" IsVisible="{Binding IsSubmitting}"
                                           Color="White" HorizontalOptions="End" Margin="0,0,18,0" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsFormBusy}" IsVisible="{Binding IsFormBusy}" Color="#2F6DEA" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsConfirmSheetVisible}" RowDefinitions="*,Auto" ZIndex="12">
            <BoxView Grid.RowSpan="2" Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseConfirmSheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,0,0"
                    Padding="20,8,20,12" ZIndex="13">
                <VerticalStackLayout Spacing="14">
                    <BoxView HeightRequest="4" WidthRequest="38" CornerRadius="2" Color="#D0D5DD" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="●" FontSize="17" TextColor="#18B35B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="确认接班" FontSize="16" FontAttributes="Bold" TextColor="#172033"
                               VerticalOptions="Center" Margin="7,0,0,0" />
                    </Grid>

                    <Border BackgroundColor="#FAFBFC" Stroke="#E1E6ED" StrokeShape="RoundRectangle 10" Padding="14,12">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="58,*" RowSpacing="12">
                            <Label Text="交班方" FontSize="11" TextColor="#667085" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ConfirmHandoverTeamName, StringFormat='{0}（当前班次）'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#172033" />
                            <Label Grid.Row="1" Text="交班人" FontSize="11" TextColor="#667085" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ConfirmHandoverUserName}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#172033" />
                            <Label Grid.Row="2" Text="交班备注" FontSize="11" TextColor="#667085" VerticalOptions="Start" Margin="0,8,0,0" />
                            <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" Stroke="#D8DEE8"
                                    StrokeShape="RoundRectangle 6" Padding="10" MinimumHeightRequest="48">
                                <Label Text="{Binding ConfirmMemo}" FontSize="12" TextColor="#344054" LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#FFFBE7" Stroke="#FFD74A" StrokeShape="RoundRectangle 9" Padding="12,10">
                        <Grid ColumnDefinitions="20,*">
                            <Label Text="!" TextColor="#E9A400" FontAttributes="Bold" FontSize="12" />
                            <Label Grid.Column="1" Text="请确认现场设备与物料已清点无误。点击下方按钮即代表您已正式接班。"
                                   FontSize="11" TextColor="#9B6500" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Text="我已确认，正式接班" Command="{Binding ConfirmHandoverCommand}" BackgroundColor="#16AD55"
                                TextColor="White" FontSize="14" FontAttributes="Bold" CornerRadius="9" HeightRequest="44" />
                        <ActivityIndicator IsRunning="{Binding IsConfirming}" IsVisible="{Binding IsConfirming}"
                                           Color="White" HorizontalOptions="End" Margin="0,0,18,0" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsConfirmFormBusy}" IsVisible="{Binding IsConfirmFormBusy}"
                                       Color="#16AD55" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsDetailSheetVisible}" RowDefinitions="*,Auto" ZIndex="14">
            <BoxView Grid.RowSpan="2" Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDetailSheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,0,0"
                    Padding="17,8,17,14" ZIndex="15">
                <VerticalStackLayout Spacing="12">
                    <BoxView HeightRequest="4" WidthRequest="38" CornerRadius="2" Color="#D0D5DD" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="▣" FontSize="17" TextColor="#2F6DEA" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="记录详情" FontSize="16" FontAttributes="Bold" TextColor="#172033"
                               VerticalOptions="Center" Margin="7,0,0,0" />
                    </Grid>

                    <Grid BackgroundColor="#F5F7FA" Padding="10,8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding DetailRecordTime}" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
                        <Border Grid.Column="1" BackgroundColor="{Binding DetailStatusBackground}" Stroke="{Binding DetailStatusColor}"
                                StrokeShape="RoundRectangle 8" Padding="7,2">
                            <Label Text="{Binding DetailStatusText}" FontSize="10" FontAttributes="Bold" TextColor="{Binding DetailStatusColor}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border BackgroundColor="#F5F9FF" Stroke="#C9DFFF" StrokeShape="RoundRectangle 8" Padding="10,9">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="交班方" FontSize="10" FontAttributes="Bold" TextColor="#1262E3" />
                                <BoxView HeightRequest="1" Color="#C9DFFF" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding DetailHandoverTeamName}" FontSize="13" FontAttributes="Bold" TextColor="#172033" />
                                    <Label Text="{Binding DetailHandoverShiftName, StringFormat='（{0}）'}" FontSize="9" TextColor="#667085" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding DetailHandoverUserName, StringFormat='♙  {0}'}" FontSize="10" TextColor="#667085" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#F3FFF7" Stroke="#BDEECC" StrokeShape="RoundRectangle 8" Padding="10,9">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="接班方" FontSize="10" FontAttributes="Bold" TextColor="#16A65A" />
                                <BoxView HeightRequest="1" Color="#BDEECC" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding DetailReceiverTeamName}" FontSize="13" FontAttributes="Bold" TextColor="#172033" />
                                    <Label Text="{Binding DetailReceiverShiftName, StringFormat='（{0}）'}" FontSize="9" TextColor="#667085" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding DetailReceiverUserName, StringFormat='♙  {0}'}" FontSize="10" TextColor="#667085" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="现场纪要" FontSize="11" TextColor="#667085" />
                        <Border BackgroundColor="#FAFBFC" Stroke="#D8DEE8" StrokeShape="RoundRectangle 8"
                                Padding="12" MinimumHeightRequest="76">
                            <Label Text="{Binding DetailMemo}" FontSize="12" TextColor="#344054" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsDetailBusy}" IsVisible="{Binding IsDetailBusy}" Color="#2F6DEA" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
